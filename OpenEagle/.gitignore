# ========================================================
# Node.js 项目 .gitignore
# ========================================================

# 依赖目录
node_modules/

# 构建输出
dist/
build/

# 类型声明输出（如果有）
*.tsbuildinfo

# 环境配置（包含敏感信息！）
.env
.env.local
.env.*.local

# 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.log

# IDE 和编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统文件
.DS_Store
Thumbs.db
nul

# 临时文件
*.tmp
*.temp
.cache/

# 工作区数据（运行时生成）
workspace/

# 测试和覆盖率
coverage/
.nyc_output/

# 打包文件
*.tar.gz
*.zip
*.tar

# Docker 相关（可选，根据需要）
docker-compose.override.yml

# Python
__pycache__/
*.pyc

# 备份目录
backups/
