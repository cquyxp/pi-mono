# ========================================================
# 环境变量配置示例
# ========================================================
# 使用说明：
#   1. 复制这个文件为 .env
#   2. 修改 .env 中的配置
#   3. 不要把 .env 提交到 Git！
# ========================================================

# ========================================================
# 服务器配置
# ========================================================
PORT=7187
NODE_ENV=production

# ========================================================
# 目录配置（可选）
# ========================================================
# 工作目录（存放会话、记忆等数据）
WORKSPACE_DIR=./workspace
# 设置目录
SETTINGS_DIR=./workspace/settings

# ========================================================
# API Keys（填入你的）
# ========================================================
# 获取这些 Keys：
#   Anthropic: https://console.anthropic.com/
#   OpenAI: https://platform.openai.com/api-keys
#   Groq: https://console.groq.com/keys
#   火山引擎: https://console.volcengine.com/

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (GPT)
OPENAI_API_KEY=

# Groq
GROQ_API_KEY=

# 火山引擎
VOLCENGINE_API_KEY=

# ========================================================
# 其他配置
# ========================================================
# 日志级别: debug, info, warn, error
LOG_LEVEL=info
