# 不需要复制到 Docker 镜像中的文件

# 依赖目录
node_modules/

# 构建输出
dist/
build/

# Git 相关
.git/
.gitignore
.gitattributes

# 环境配置（包含敏感信息，不要打包进镜像）
.env
.env.local
.env.*.local

# 日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE 和编辑器
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# 临时文件
*.tmp
*.temp

# 工作区数据（通过 volume 挂载，不要打包进镜像）
workspace/

# 文档（不需要在运行时）
*.md
!README.md

# 测试和覆盖率
coverage/
*.test.ts
*.spec.ts

# 打包文件
*.tar.gz
*.zip
