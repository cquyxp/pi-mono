{
  "name": "example-embedded-pi",
  "version": "1.0.0",
  "type": "module",
  "description": "Example of embedding pi-coding-agent similar to OpenClaw with web UI",
  "main": "src/index.js",
  "scripts": {
    "start": "npx tsx src/server/index.ts",
    "demo": "npx tsx src/demo.ts",
    "dev": "npx tsx watch src/server/index.ts",
    "evolution:scan": "npx tsx src/evolution-demo.ts scan",
    "evolution:once": "npx tsx src/evolution-demo.ts once",
    "evolution:status": "npx tsx src/evolution-demo.ts status",
    "frontend:install": "cd pi-agent-frontend && npm install",
    "frontend:dev": "cd pi-agent-frontend && npm run dev",
    "frontend:build": "cd pi-agent-frontend && npm run build"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.49.3",
    "@mariozechner/pi-ai": "^0.49.3",
    "@mariozechner/pi-coding-agent": "^0.49.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "pi",
    "ai",
    "agent",
    "embedded",
    "llm",
    "webui"
  ],
  "author": "",
  "license": "MIT"
}
